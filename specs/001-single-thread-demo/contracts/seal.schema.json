{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noor.local/contracts/seal.schema.json",
  "title": "noor.seal/v1",
  "description": "ملف ختم مستقل (FR-016). تحقق سلامة، ليس توقيعًا ولا إثبات هوية.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "noor.seal/v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^RR-[0-9a-f]{12}$"
    },
    "algorithm": {
      "const": "sha256"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "rfp"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "version_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            }
          },
          "required": [
            "role",
            "sha256",
            "size",
            "version_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "proposal"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "version_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            }
          },
          "required": [
            "role",
            "sha256",
            "size",
            "version_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "report"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "version_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            }
          },
          "required": [
            "role",
            "sha256",
            "size",
            "version_id"
          ]
        }
      ],
      "items": false,
      "minItems": 3
    },
    "notice": {
      "const": "integrity-only; not a signature; does not prove issuer identity"
    },
    "synthetic": {
      "const": true
    }
  },
  "required": [
    "schema",
    "report_id",
    "algorithm",
    "created_at",
    "entries",
    "notice",
    "synthetic"
  ]
}
