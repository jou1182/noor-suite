{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noor.local/contracts/review-report.schema.json",
  "title": "noor.review-report/v1",
  "description": "JoUReady ← NMIS (W4). فحوص حتمية فقط؛ الحالة «مقترح» دائمًا عند الإصدار (FR-017).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "noor.review-report/v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^RR-[0-9a-f]{12}$"
    },
    "tender_id": {
      "type": "string",
      "pattern": "^NT-[0-9]{4}-[0-9]{4}$"
    },
    "proposal_version": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfp_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_state": {
      "const": "proposed"
    },
    "checks_run": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,6}-[0-9]{2,3}$"
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}-[0-9]{2,3}$"
          },
          "result": {
            "enum": [
              "match",
              "mismatch",
              "unverifiable"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "doc": {
                  "enum": [
                    "rfp",
                    "proposal"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "pattern": "^(p|t)[0-9]{1,5}(:r[0-9]{1,4}c[0-9]{1,3})?$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "doc",
                "sha256",
                "locator"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "finding_key",
          "criterion_id",
          "result",
          "sources",
          "message"
        ],
        "if": {
          "properties": {
            "result": {
              "const": "match"
            }
          }
        },
        "then": {
          "properties": {
            "sources": {
              "items": {
                "required": [
                  "doc",
                  "sha256",
                  "locator",
                  "quote"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "criterion_id": {
                  "pattern": "^SBC-"
                },
                "result": {
                  "const": "match"
                }
              },
              "required": [
                "criterion_id",
                "result"
              ]
            },
            "then": {
              "properties": {
                "sources": {
                  "allOf": [
                    {
                      "contains": {
                        "properties": {
                          "doc": {
                            "const": "rfp"
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "properties": {
                          "doc": {
                            "const": "proposal"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "maxItems": 500
    },
    "synthetic": {
      "const": true
    }
  },
  "required": [
    "schema",
    "report_id",
    "tender_id",
    "proposal_version",
    "proposal_sha256",
    "rfp_sha256",
    "generated_at",
    "approval_state",
    "checks_run",
    "limitations",
    "findings",
    "synthetic"
  ]
}
