{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noor.local/contracts/tender.schema.json",
  "title": "noor.tender/v1",
  "description": "NMIS ← ATPAS وJoUReady (W3/W4). سجل منافسة مقبولة بالمعرّف الموحد.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "noor.tender/v1"
    },
    "tender_id": {
      "type": "string",
      "pattern": "^NT-[0-9]{4}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "issuing_entity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "closing_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_type": {
      "type": "string",
      "pattern": "^[a-z_]{2,40}$"
    },
    "status": {
      "const": "accepted"
    },
    "etimad_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Za-z-]{1,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "activity_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}(-[0-9]{2,3})?$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "synthetic": {
      "const": true
    }
  },
  "required": [
    "schema",
    "tender_id",
    "title",
    "issuing_entity",
    "closing_at",
    "project_type",
    "status",
    "activity_codes",
    "synthetic"
  ]
}
